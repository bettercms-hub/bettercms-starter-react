{
  "name": "bettercms-starter-react",
  "version": "0.1.0",
  "private": true,
  "description": "BetterCMS Marketing Starter (React + TypeScript on Vite) — Home, About, Contact (with form), Blog, and Case Studies, rendered from a BetterCMS project and prerendered to static HTML.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build",
    "preview": "vite preview --outDir dist",
    "typecheck": "tsc --noEmit",
    "fetch-content": "node scripts/fetch-content.mjs"
  },
  "dependencies": {
    "@bettercms-ai/next": "^0.11.0",
    "@bettercms-ai/sdk": "^1.10.0",
    "@bettercms-ai/types": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.0",
    "vite": "^7.3.0",
    "vite-react-ssg": "^0.9.2"
  }
}
